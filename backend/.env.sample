# Origins allowed to call the API. When unset, any http(s)://localhost,
# 127.0.0.1 or [::1] origin is allowed.
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# 127.0.0.1 only accepts local connections. Workspaces without a password are
# open to anyone who can reach the server.
HOST=127.0.0.1
PORT=5000
# Workspace passwords. "false" opens every workspace and hides the password
# options; passwords already set are kept for when it is turned back on.
AUTH_ENABLED=true
# Defaults to backend/data/drawdb.sqlite3
# DATABASE_PATH=/path/to/drawdb.sqlite3
# "dev" allows any origin and enables auto-reload.
NODE_ENV=dev
MAIL_USERNAME=mail@example.com
MAIL_PASSWORD=my-app-password
# gmail, outlook, hotmail, outlook365, yahoo or zoho. For anything else set
# MAIL_HOST and MAIL_PORT (465 uses SSL, other ports use STARTTLS).
MAIL_SERVICE=gmail
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
